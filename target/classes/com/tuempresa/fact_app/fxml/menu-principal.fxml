<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.Tooltip?>


<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuempresa.fact_app.controller.MenuPrincipalController">
    <top>
        <VBox>
            <MenuBar>
                <Menu text="Mantenimiento">
                    <MenuItem fx:id="mnuProductos" onAction="#abrirProductos" text="Productos">
                        <graphic>
                            <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                <image><Image url="@../icons/producto.png" /></image>
                            </ImageView>
                        </graphic>

                    </MenuItem>
                    <MenuItem fx:id="mnuCargos" onAction="#abrirCargos" text="Cargos">
                        <graphic>
                            <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                <image><Image url="@../icons/cargo.png" /></image>
                            </ImageView>
                        </graphic>
                    </MenuItem>
                    <MenuItem fx:id="mnuCategorias" onAction="#abrirCategorias" text="Categorías">
                        <graphic>
                            <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                <image><Image url="@../icons/categoria.png" /></image>
                            </ImageView>
                        </graphic>
                    </MenuItem>
                </Menu>
                <Menu text="Sistema">
                    <MenuItem fx:id="mnuSalir" onAction="#salir" text="Salir">
                        <graphic>
                            <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                <image><Image url="@../icons/salir.png" /></image>
                            </ImageView>
                        </graphic>
                    </MenuItem>
                </Menu>
            </MenuBar>
            <ToolBar>
                <Button fx:id="btnProductos" onAction="#abrirProductos">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <image><Image url="@../icons/producto.png" /></image>
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text=" Productos "/>
                    </tooltip>

                </Button>
                <Button fx:id="btnCargos" onAction="#abrirCargos">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <image><Image url="@../icons/cargo.png" /></image>
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text=" Cargo "/>
                    </tooltip>

                </Button>
                <Button fx:id="btnCategorias" onAction="#abrirCategorias">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <image><Image url="@../icons/categoria.png" /></image>
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text=" Categorias "/>
                    </tooltip>

                </Button>
                <Pane HBox.hgrow="ALWAYS" />
                <Button fx:id="btnSalir" onAction="#salir">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <image><Image url="@../icons/salir.png" /></image>
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text=" Salir "/>
                    </tooltip>
                </Button>
            </ToolBar>
        </VBox>
    </top>
    <center>
        <Label text="Sistema de facturación">
            <font><Font size="36.0" /></font>
        </Label>
    </center>
</BorderPane>
