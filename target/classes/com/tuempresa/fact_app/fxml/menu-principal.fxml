<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuempresa.fact_app.controller.MenuPrincipalController">
    <top>
        <VBox>
            <MenuBar>
                <Menu text="Mantenimiento">
                    <MenuItem fx:id="mnuProductos" text="Productos" onAction="#abrirProductos">
                        <graphic>
                            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                <image><Image url="@../icons/producto.png"/></image>
                            </ImageView>
                        </graphic>
                    </MenuItem>
                    <MenuItem fx:id="mnuCargos" text="Cargos" onAction="#abrirCargos">
                        <graphic>
                            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                <image><Image url="@../icons/cargo.png"/></image>
                            </ImageView>
                        </graphic>
                    </MenuItem>
                    <MenuItem fx:id="mnuCategorias" text="Categorías" onAction="#abrirCategorias">
                        <graphic>
                            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                <image><Image url="@../icons/categoria.png"/></image>
                            </ImageView>
                        </graphic>
                    </MenuItem>
                </Menu>
                <Menu text="Sistema">
                    <MenuItem fx:id="mnuSalir" text="Salir" onAction="#salir">
                        <graphic>
                            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                <image><Image url="@../icons/salir.png"/></image>
                            </ImageView>
                        </graphic>
                    </MenuItem>
                </Menu>
            </MenuBar>
            <ToolBar>
                <Button fx:id="btnProductos" text="Productos" onAction="#abrirProductos">
                    <graphic>
                        <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                            <image><Image url="@../icons/producto.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="btnCargos" text="Cargos" onAction="#abrirCargos">
                    <graphic>
                        <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                            <image><Image url="@../icons/cargo.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="btnCategorias" text="Categorías" onAction="#abrirCategorias">
                    <graphic>
                        <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                            <image><Image url="@../icons/categoria.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Pane HBox.hgrow="ALWAYS" />
                <Button fx:id="btnSalir" text="Salir" onAction="#salir">
                    <graphic>
                        <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                            <image><Image url="@../icons/salir.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
            </ToolBar>
        </VBox>
    </top>
    <center>
        <Label text="Sistema de facturación">
            <font><Font size="36.0" /></font>
        </Label>
    </center>
</BorderPane>