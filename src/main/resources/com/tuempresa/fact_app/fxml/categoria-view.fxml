<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuempresa.fact_app.controller.CategoriaController">
   <top>
      <VBox spacing="15">
         <padding><Insets top="20" right="20" bottom="10" left="20"/></padding>
         <GridPane hgap="10" vgap="15">
            <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtId" editable="false" promptText="Autogenerado" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Nombre de Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="250"/>

            <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <CheckBox fx:id="chkActivo" text="Activo" selected="true" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
         </GridPane>
         <HBox spacing="15" alignment="CENTER_LEFT">
            <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar"/>
            <Button fx:id="btnLimpiar" text="Limpiar" onAction="#limpiar"/>
            <Button fx:id="btnCerrar" text="Cerrar" onAction="#cerrar"/>
         </HBox>
      </VBox>
   </top>
   <center>
      <TableView fx:id="tblCategorias">
         <padding><Insets top="10" right="20" bottom="20" left="20"/></padding>
         <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="300"/>
            <TableColumn fx:id="colActivo" text="Activo" prefWidth="100"/>
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
         </columnResizePolicy>
      </TableView>
   </center>
</BorderPane>