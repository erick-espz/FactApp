<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuempresa.fact_app.controller.CargoController">
   <top>
      <VBox spacing="15">
         <padding><Insets bottom="10" left="20" right="20" top="20" /></padding>
         <GridPane hgap="10" vgap="15">
            <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtId" editable="false" promptText="Autogenerado" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Nombre del Cargo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtNombre" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <columnConstraints>
               <ColumnConstraints />
               <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
         </GridPane>
         <HBox alignment="CENTER_LEFT" spacing="15">
            <Button fx:id="btnGuardar" onAction="#guardar" text="Guardar" textFill="#33a635" />
            <Button fx:id="btnLimpiar" onAction="#limpiar" text="Limpiar" textFill="#17a0c3" />
            <Button fx:id="btnCerrar" onAction="#cerrar" text="Cerrar" />
         </HBox>
      </VBox>
   </top>
   <center>
      <TableView fx:id="tblCargos">
         <padding><Insets bottom="20" left="20" right="20" top="10" /></padding>
         <columns>
            <TableColumn fx:id="colId" prefWidth="80" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="350" text="Cargo" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
</BorderPane>
